  "sources": [
    {
      "name": "FreePats Electric Guitar FSBS, Distorted #2",
      "url": "https://github.com/freepats/electric-guitar-FSBS-dist2",
      "pin": {
        "commit": "21261b8bcb02d1cbf52dc02f1b1636df52d4a947"
      },
      "licence": "CC0-1.0",
      "author": "FreePats",
      "changes": "Below C4 only, both velocity layers, the first of four round robins. Leading silence trimmed (−48 dBFS, 1 ms kept). Tails cut at 8 s with a 60 ms linear fade-out. Re-encoded as 128 kbps MP3."
    },
    {
      "name": "FreePats Electric Guitar FSBS, Clean #1 small",
      "url": "https://github.com/freepats/electric-guitar-FSBS-clean",
      "pin": {
        "commit": "192cf0d9bf2c4ba6ead8e3524ba3f78818e4fe91"
      },
      "licence": "CC0-1.0",
      "author": "FreePats",
      "changes": "From C4 up only. An amp drive baked in: gain 4.25, a tanh curve (k 3.2) at 4× oversampling, a 90 Hz high-pass, +4 dB at 900 Hz, a 4.6 kHz low-pass, then gain 0.28. Level-matched to Distorted #2 at C4 by region gain. Leading silence trimmed (−48 dBFS, 1 ms kept). SFZ loops kept where they end within 8 s; every other note fades out over its last 60 ms, cut at 8 s where longer. Re-encoded as 128 kbps MP3."
    }
  ],
