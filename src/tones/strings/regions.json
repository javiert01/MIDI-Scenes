  "toneId": "strings",
  "sources": [
    {
      "name": "VSCO 2 Community Edition: Cello Section and Violin Section, sustained vibrato",
      "url": "https://github.com/sgossner/VSCO-2-CE",
      "pin": {
        "commit": "440300901dfe9275fd84e0b7763af1f8443ae62e"
      },
      "licence": "CC0-1.0",
      "author": "Versilian Studios (Sam Gossner, Simon Dalzell)",
      "changes": "Cello Section below C4 and Violin Section from C4, both dynamic layers. Leading silence trimmed (−48 dBFS, 1 ms kept). A 2 s equal-power crossfade loop baked in, ending 0.6 s before the sample ends (the rest is cut) and starting 0.5 s after the crossfade does. Re-encoded as 128 kbps MP3."
    },
    {
      "name": "VSCO 2 Community Edition SFZ mappings",
      "url": "https://github.com/sgossner/VSCO-2-CE/tree/SFZ",
      "pin": {
        "commit": "6dd651d55dde97fd4028699be9d4481f26917891"
      },
      "licence": "CC0-1.0",
      "author": "Versilian Studios (Sam Gossner, Simon Dalzell)",
      "changes": "Key ranges, velocity layers and volumes from CelloEnsSusVib.sfz and ViolinEnsSusVib.sfz, split at C4 and widened to cover 36–95."
    }
  ],
